```python
from dataclasses import dataclass
import numpy as np
import pandas as pd


@dataclass
class VolumeProfileResult:
    poc: float
    vah: float
    val: float
    total_volume: float
    profile_distribution: pd.DataFrame


def compute_volume_profile(
    df: pd.DataFrame, bins: int = 40, value_area_pct: float = 0.70
) -> VolumeProfileResult:
    """
    Computes Volume Profile metrics (POC, VAH, VAL) from OHLCV DataFrame.
    """
    required = {"high", "low", "close", "volume"}
    if not required.issubset(df.columns):
        raise ValueError(f"DataFrame must contain {required}")

    typical_price = (df["high"] + df["low"] + df["close"]) / 3.0
    price_min, price_max = df["low"].min(), df["high"].max()
    bin_edges = np.linspace(price_min, price_max, bins + 1)

    bin_indices = np.digitize(typical_price, bin_edges) - 1
    bin_indices = np.clip(bin_indices, 0, bins - 1)

    vol_by_bin = np.bincount(bin_indices, weights=df["volume"], minlength=bins)
    bin_centers = (bin_edges[:-1] + bin_edges[1:]) / 2.0

    poc_idx = int(np.argmax(vol_by_bin))
    poc_price = round(float(bin_centers[poc_idx]), 2)

    total_vol = float(np.sum(vol_by_bin))
    target_vol = total_vol * value_area_pct

    accumulated_vol = vol_by_bin[poc_idx]
    low_idx, high_idx = poc_idx, poc_idx

    while accumulated_vol < target_vol and (low_idx > 0 or high_idx < bins - 1):
        next_low_vol = vol_by_bin[low_idx - 1] if low_idx > 0 else -1.0
        next_high_vol = vol_by_bin[high_idx + 1] if high_idx < bins - 1 else -1.0

        if next_high_vol >= next_low_vol:
            high_idx += 1
            accumulated_vol += next_high_vol
        else:
            low_idx -= 1
            accumulated_vol += next_low_vol

    dist_df = pd.DataFrame({"price_level": bin_centers, "volume": vol_by_bin})

    return VolumeProfileResult(
        poc=poc_price,
        vah=round(float(bin_centers[high_idx]), 2),
        val=round(float(bin_centers[low_idx]), 2),
        total_volume=round(total_vol, 2),
        profile_distribution=dist_df,
    )


def compute_cvd_approximation(df: pd.DataFrame) -> pd.Series:
    """
    Approximates Cumulative Volume Delta (CVD) from OHLCV bars using candle range ratios.
    """
    bar_range = (df["high"] - df["low"]).replace(0, np.nan)
    buy_ratio = (df["close"] - df["low"]) / bar_range
    sell_ratio = (df["high"] - df["close"]) / bar_range

    delta_ratio = (buy_ratio - sell_ratio).fillna(0.0)
    volume_delta = df["volume"] * delta_ratio

    return volume_delta.cumsum()
